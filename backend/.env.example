APP_NAME=CricIntel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cricintel
DB_USERNAME=cricintel_user
DB_PASSWORD=CHANGE_THIS_PASSWORD

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

SANCTUM_STATEFUL_DOMAINS=localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173


# Broadcasting
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=cricintel-local
REVERB_APP_KEY=cricintel-local-key
REVERB_APP_SECRET=cricintel-local-secret

REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Reverb server bind
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Existing local queue can remain database
QUEUE_CONNECTION=database

# Optional Redis:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
